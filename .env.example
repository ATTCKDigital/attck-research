# Copy to .env (gitignored) and fill in.
# Free keys: https://openalex.org (sends a confirmation email) and
# https://www.semanticscholar.org/product/api#api-key-form (approval can take days).
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Read-only access to the WordPress site over the WP Engine SSH gateway (WP-CLI).
WPE_SSH_TARGET=attck@attck.ssh.wpengine.net
WPE_SSH_KEY=~/.ssh/wpe_attck
# Category that holds the series.
SERIES_CATEGORY_ID=229
